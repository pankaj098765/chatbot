# ─────────────────────────────────────────────────────────────────
# REQUIRED — Bot & Infrastructure
# ─────────────────────────────────────────────────────────────────

# Telegram Bot Token — get one from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# MongoDB connection string
MONGODB_URI=mongodb://mongo:27017

# Redis connection string
REDIS_URL=redis://redis:6379

# MongoDB database name
DB_NAME=anonymous_chat

# ─────────────────────────────────────────────────────────────────
# BRANDING — White-label identity
# ─────────────────────────────────────────────────────────────────

# Your bot's display name (shown in welcome messages)
# This is the default — change it to your own brand name
BRAND_NAME=Anonymous Chat

# ─────────────────────────────────────────────────────────────────
# LANGUAGE — Default user experience
# ─────────────────────────────────────────────────────────────────

# Default UI language for new users (ISO 639-1 code)
# Options: en, hi, es, fr, de, pt, ar, ru, tr, id
DEFAULT_LANGUAGE=en

# Comma-separated list of languages users can choose from
# Must be a subset of the supported list above
ALLOWED_LANGUAGES=en,hi,es

# Default chat mode for new users
# Options: mixed | english | native
#   mixed   — user's language + English blend
#   english — English only regardless of user language
#   native  — user's chosen language only
DEFAULT_CHAT_MODE=mixed

# ─────────────────────────────────────────────────────────────────
# FEATURE TOGGLES
# ─────────────────────────────────────────────────────────────────

# Enable LLM-powered (AI) fallback responses (requires OPENAI_API_KEY)
# Set to false to use template-only responses — no API key needed
AI_ENABLED=true

# Enable Telegram Stars payment commands (/pay, /vip)
# Set to false to hide payment features entirely
PAYMENT_ENABLED=true

# ─────────────────────────────────────────────────────────────────
# LLM / AI (only required when AI_ENABLED=true)
# ─────────────────────────────────────────────────────────────────
#
# ✅ ZERO-CONFIG SETUP — just paste your API key here.
#    The bot automatically detects the provider and picks the best model.
#    No other LLM settings need to be changed.
#
#    Supported auto-detection from key format:
#      sk-ant-…  →  Anthropic (Claude)
#      gsk_…     →  Groq (Llama / Mixtral)
#      AIza…     →  Gemini (Google)
#      xai-…     →  Grok (xAI)
#      sk-…      →  OpenAI (GPT)  ← DeepSeek also uses sk-; set LLM_PROVIDER=deepseek to override
#
LLM_API_KEY=

# ─────────────────────────────────────────────────────────────────
# ADVANCED — only needed to override auto-detection
# ─────────────────────────────────────────────────────────────────

# Override the detected provider (optional).
# Values: openai | gemini | grok | groq | mistral | deepseek | together | anthropic | custom
LLM_PROVIDER=

# Override the model name (optional).
# If blank, the best default model for the detected provider is used automatically.
# Examples:
#   openai    → gpt-4o-mini (default)   | gpt-4o, gpt-3.5-turbo
#   gemini    → gemini-1.5-flash (def.) | gemini-1.5-pro
#   anthropic → claude-3-haiku (def.)   | claude-3-5-sonnet-20241022
#   groq      → llama-3.3-70b (def.)    | mixtral-8x7b-32768
#   grok      → grok-3-mini (def.)      | grok-2
#   mistral   → mistral-small-latest    | mistral-large-latest
#   deepseek  → deepseek-chat
#   together  → mistralai/Mistral-7B-Instruct-v0.1
LLM_MODEL=

# Custom REST endpoint — only for LLM_PROVIDER=custom (e.g. local Ollama).
# Example: LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=

# ── Provider-specific key aliases (alternative to LLM_API_KEY) ────
# These are checked when LLM_API_KEY is empty.
# Useful when you want to keep key names consistent with the provider.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=

# ─────────────────────────────────────────────────────────────────
# ADMIN DASHBOARD
# ─────────────────────────────────────────────────────────────────

# Admin dashboard bearer token — change this before deploying!
ADMIN_TOKEN=change_me_to_a_strong_secret_token

# ─────────────────────────────────────────────────────────────────
# DEBUG (development only)
# ─────────────────────────────────────────────────────────────────

DEBUG=false
