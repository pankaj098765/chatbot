# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# MongoDB connection string
MONGODB_URI=mongodb://mongo:27017

# Redis connection string
REDIS_URL=redis://redis:6379

# MongoDB database name
DB_NAME=anonymous_chat

# Debug mode (true/false)
DEBUG=false

# Admin dashboard token — change this to a strong secret before deploying
ADMIN_TOKEN=change_me_to_a_strong_secret_token

# LLM integration (OpenAI-compatible)
# Set OPENAI_API_KEY to enable LLM-powered Hinglish responses in the fallback engine.
# Leave blank to use template-only responses.
OPENAI_API_KEY=
# Model to use — gpt-4o-mini is recommended for cost/quality balance
LLM_MODEL=gpt-4o-mini
# Set to false to disable LLM globally (templates only)
LLM_ENABLED=true
